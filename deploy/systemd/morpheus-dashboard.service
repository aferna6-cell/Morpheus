[Unit]
Description=Morpheus Dashboard
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/morpheus

EnvironmentFile=/opt/morpheus/.env

ExecStart=/opt/morpheus/.venv/bin/uvicorn src.dashboard:app --host 0.0.0.0 --port 8080
Restart=on-failure
RestartSec=5

NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
