# Kalshi Configuration (required)
KALSHI_API_KEY_ID=your-kalshi-api-key-id
KALSHI_PRIVATE_KEY_PATH=/path/to/kalshi-private-key.pem
# Or inline PEM (alternative to path):
# KALSHI_PRIVATE_KEY=-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----

# OpenAI Configuration (required for LLM engine)
OPENAI_API_KEY=your-openai-api-key-here

# News search (picks first available: Tavily > Brave > DuckDuckGo fallback)
# Tavily (best for AI agents): https://tavily.com (1,000 queries/month free)
TAVILY_API_KEY=
# Brave Search: https://brave.com/search/api/ (2,000 queries/month free)
BRAVE_SEARCH_API_KEY=

# Bot Configuration Override (optional - can also use config.yaml)
LOG_LEVEL=INFO
DRY_RUN=false
