# Kalshi Configuration (required)
KALSHI_API_KEY_ID=your-kalshi-api-key-id
KALSHI_PRIVATE_KEY_PATH=/path/to/kalshi-private-key.pem
# Or inline PEM (alternative to path):
# KALSHI_PRIVATE_KEY=-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----

# Secondary Kalshi account (optional)
# KALSHI_API_KEY_ID_2=your-second-kalshi-api-key-id
# KALSHI_PRIVATE_KEY_PATH_2=/path/to/kalshi-private-key-2.pem

# Anthropic Configuration (required for ensemble LLM engine)
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# OpenAI Configuration (required for ensemble LLM engine)
OPENAI_API_KEY=your-openai-api-key-here

# Telegram Alerts (required for trade notifications)
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=your-telegram-chat-id

# News search (picks first available: Tavily > Brave > DuckDuckGo fallback)
# Tavily (best for AI agents): https://tavily.com (1,000 queries/month free)
TAVILY_API_KEY=
# Brave Search: https://brave.com/search/api/ (2,000 queries/month free)
BRAVE_SEARCH_API_KEY=

# Bot Configuration Override (optional - can also use config.yaml)
LOG_LEVEL=INFO
DRY_RUN=false
