# Morpheus — environment variables template
# Copy to .env and fill in real values. Never commit .env.

# REST Monitoring API key (generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))")
MORPHEUS_API_KEY=your-random-secret-here

# Kalshi (primary account — RSA-PSS auth, not password)
KALSHI_API_KEY_ID=your-kalshi-api-key-id
KALSHI_PRIVATE_KEY_PATH=kalshi_key.pem
# Or inline PEM (alternative to KALSHI_PRIVATE_KEY_PATH):
# KALSHI_PRIVATE_KEY=-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----

# Kalshi (secondary account — optional)
# KALSHI_API_KEY_ID_2=your-second-kalshi-api-key-id
# KALSHI_PRIVATE_KEY_PATH_2=kalshi_key_2.pem

# LLM ensemble (both required for kalshi_llm engine)
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# News search (first available wins: Brave > DuckDuckGo fallback)
# Brave: https://brave.com/search/api/ (2,000 queries/month free)
BRAVE_SEARCH_API_KEY=
# Tavily: https://tavily.com (1,000 queries/month free) — currently disabled (HTTP 432)
# TAVILY_API_KEY=

# Telegram trade alerts
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# FRED economic data (free, no rate limit): https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# Bot config overrides (can also set in config.yaml)
LOG_LEVEL=INFO
DRY_RUN=false
